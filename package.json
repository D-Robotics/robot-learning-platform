{
  "name": "@d-robotics/robot-learning-platform",
  "version": "0.1.0",
  "private": false,
  "description": "RDK-X5 × MicroDuck robot learning platform for browser simulation, RL training, model artifacts, Sim2Real evaluation, and deployment.",
  "homepage": "https://github.com/D-Robotics/robot-learning-platform#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/D-Robotics/robot-learning-platform.git"
  },
  "bugs": {
    "url": "https://github.com/D-Robotics/robot-learning-platform/issues"
  },
  "keywords": [
    "robot-learning",
    "reinforcement-learning",
    "sim2real",
    "robotics",
    "embodied-ai",
    "microduck",
    "rdk-x5",
    "mujoco",
    "onnx",
    "d-robotics"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev:sim2real": "node scripts/run-with-env.mjs node --import tsx/esm services/sim2real-web/server.ts",
    "dev:mock-worker": "node scripts/run-with-env.mjs node services/sim2real-web/mock-local-worker.mjs",
    "dev:local-worker": "node scripts/run-with-env.mjs node services/sim2real-web/local-training-worker.mjs",
    "dev:board-agent": "node scripts/run-with-env.mjs node services/sim2real-web/local-board-agent.mjs",
    "demo:sim2real": "node scripts/demo-sim2real.mjs",
    "demo:starter": "node scripts/demo-starter.mjs",
    "doctor": "node scripts/doctor.mjs",
    "accept:new-device": "node scripts/accept-new-device.mjs",
    "onboard:stack": "node scripts/onboard-stack.mjs",
    "smoke:sim2real-local": "node scripts/sim2real-local-e2e-smoke.mjs",
    "verify:api-contract": "node scripts/verify-api-contract.mjs",
    "build": "tsc -p tsconfig.build.json && npm run build:assets",
    "build:assets": "node scripts/copy-server-assets.mjs",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:ui": "node services/sim2real-web/ui-ia.spec.mjs",
    "verify:escape-audit": "node services/sim2real-web/escape-audit.spec.mjs",
    "verify:task-pack": "node scripts/verify-task-pack.mjs",
    "verify:recorder": "node services/mujoco-web/microduck-community-overlay.test.mjs",
    "verify:deployment": "node scripts/verify-deployment-assets.mjs",
    "verify:examples": "node scripts/verify-examples.mjs",
    "verify:local-worker": "node services/sim2real-web/local-training-worker.test.mjs",
    "verify:board-agent": "node services/sim2real-web/local-board-agent.test.mjs",
    "verify:device-connections": "node services/sim2real-web/device-connections.spec.mjs",
    "verify:board-drive": "python3 services/sim2real-web/board-agent-drive.test.py",
    "verify:policy-runtime": "python3 scripts/verify-policy-runtime-safety.py",
    "verify:policy-provider-layout": "python3 scripts/verify-policy-provider-layout.py",
    "verify:hardware-profiles": "node scripts/verify-hardware-adapters.mjs && node scripts/verify-hardware-profile.mjs",
    "verify:real-loop": "node scripts/verify-real-loop.mjs",
    "verify:starter-engine": "node scripts/verify-starter-engine.mjs",
    "compile:policy": "node scripts/compile-policy.mjs",
    "verify:vision-model": "node scripts/verify-vision-model.mjs",
    "verify:gpu-onboarding": "node scripts/onboard-gpu-server.test.mjs",
    "verify:mjlab-adapter": "node scripts/verify-mjlab-adapter.mjs",
    "verify": "npm run verify:ui && npm run verify:escape-audit && npm run verify:task-pack && npm run verify:task-templates && npm run verify:goalnav && npm run verify:originbot-env && npm run verify:originbot-telemetry && npm run verify:recorder && npm run verify:deployment && npm run verify:examples && npm run verify:local-worker && npm run verify:board-agent && npm run verify:device-connections && npm run verify:board-drive && npm run verify:policy-runtime && npm run verify:policy-provider-layout && npm run verify:hardware-profiles && npm run verify:real-loop && npm run verify:starter-engine && npm run verify:mjlab-adapter && npm run build && npm run verify:api-contract && npm run smoke:sim2real-local && node services/sim2real-web/server-wiring.spec.mjs && npm test",
    "verify:goalnav": "python3 engines/rdk-rl-env/test_goal_navigation.py",
    "verify:originbot-env": "python3 engines/rdk-rl-env/test_originbot_env.py",
    "verify:task-templates": "node scripts/verify-task-templates.mjs",
    "create:adapter": "node scripts/create-robot-adapter.mjs",
    "demo:originbot": "node scripts/demo-originbot.mjs",
    "demo:originbot-live": "node scripts/demo-originbot-live.mjs",
    "verify:originbot-telemetry": "node scripts/verify-originbot-telemetry.mjs",
    "verify:live-board": "node scripts/verify-live-board.mjs",
    "train:originbot": "python3 engines/rdk-rl-env/train_originbot.py"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  }
}
