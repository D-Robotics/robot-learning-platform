    "verify:ci:contracts": "npm run verify:ui && npm run verify:golden-path && npm run verify:escape-audit && npm run verify:task-pack && npm run verify:task-templates && npm run verify:hardware-profiles && npm run verify:engine-locks && npm run verify:training-provenance && npm run verify:examples && npm run verify:recorder && npm run verify:production-config && npm run verify:production-config-test && npm run verify:mlops-foundation && npm run verify:storage-backup && npm run verify:service-probe && npm run verify:security",
    "verify:ci:python-contracts": "npm run verify:quality-gate-parity && npm run verify:invariants && npm run verify:reward-parity && npm run verify:reward-env-parity && npm run verify:goalnav && npm run verify:originbot-env && npm run verify:originbot-calibration && npm run verify:originbot-telemetry",
    "verify:ci:engines": "npm run verify:offline-bc && npm run verify:act && npm run verify:diffusion-policy && npm run verify:smolvla && npm run verify:lerobot-converter && npm run verify:microduck-rl-adapter && npm run verify:microduck-rl-parity && npm run verify:microduck-eval && npm run verify:microduck-recurrent && npm run verify:mujoco-models && npm run verify:mjlab-adapter && npm run verify:dm-control-adapter && npm run verify:mjx-adapter",
    "verify:ci:agents": "npm run verify:local-worker && npm run verify:board-agent && npm run verify:gpu-agent && npm run verify:board-drive && npm run verify:board-uploader && npm run verify:policy-runtime && npm run verify:joint-policy-runtime && npm run verify:real-loop && npm run verify:starter-engine && npm run verify:artifact-registry && npm run verify:board-latency && npm run verify:policy-input-binding && npm run verify:vision-observation",
    "verify:ci:build-e2e": "npm run build && npm run verify:api-contract && npm run smoke:sim2real-local && node services/sim2real-web/server-wiring.spec.mjs && npm run verify:device-connections && npm run verify:policy-provider-layout && npm run verify:deployment",
    "verify:preflight": "npx prettier --check . && npm run lint -- --max-warnings=0 && npx tsc -p tsconfig.build.json --noEmit && node scripts/lock-engines.mjs --check && npm run verify:api-contract"
  },
