    "demo:originbot": "node scripts/demo-originbot.mjs",
    "demo:originbot-live": "node scripts/demo-originbot-live.mjs",
    "verify:originbot-telemetry": "node scripts/verify-originbot-telemetry.mjs",
    "verify:live-board": "node scripts/verify-live-board.mjs",
