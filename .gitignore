artifacts/
# Local Sim2Real ledger snapshots can contain telemetry and account metadata.
# Keep them out of commits; production backups belong in an encrypted backup
# volume or object store.
backups/
# Demo recordings are multi-MB binaries; publish them as GitHub Release
# assets or external links instead of growing every clone.
docs/*.mp4

# Local GUI-test screenshot artifacts, not source.
gui-test-screenshots/

# DSH session persistence root; contains per-conversation transcripts and is
# relocatable via RDK_SIM2REAL_DSH_HOME (defaults under the storage ledger).
.sim2real-dsh/
.data/dsh-sessions/

# Local operator notes; may contain private infrastructure addresses.
docs/server-inventory.local.md
