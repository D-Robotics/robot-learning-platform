node_modules/
dist/
dist-server/
coverage/
.data/
.venv/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
!.env.example
*.log
artifacts/
# Local Sim2Real ledger snapshots can contain telemetry and account metadata.
# Keep them out of commits; production backups belong in an encrypted backup
# volume or object store.
backups/
# Demo recordings are multi-MB binaries; publish them as GitHub Release
# assets or external links instead of growing every clone.
docs/*.mp4

# BPU compile outputs (X5 .bin / .hbm) and calibration blobs are build
# artifacts: reproduce them with engines/microduck-rl-adapter/x5/rdk-bpu-compile.sh
# and verify the digest recorded in that directory's README.
*.bin
*.hbm
engines/microduck-rl-adapter/x5/calib_raw/
engines/microduck-rl-adapter/x5/workspace/

# Local GUI-test screenshot artifacts, not source.
gui-test-screenshots/

# DSH session persistence root; contains per-conversation transcripts and is
# relocatable via RDK_SIM2REAL_DSH_HOME (defaults under the storage ledger).
.sim2real-dsh/
.data/dsh-sessions/

# Local operator notes; may contain private infrastructure addresses.
docs/server-inventory.local.md

# ZCode agent session plans reference local machine paths and internal
# deployment topology; they are working notes, not repo content.
.zcode/

# MuJoCo runtime log written next to the CWD of physics backends.
MUJOCO_LOG.TXT

# Local python envs for engine harnesses (recreate with the engine README).
.eval-venv/

# Root-level rehearsal/run outputs (scripts write these into scratch/job dirs;
# a bare `python3 board-latency-rehearsal.py` style run drops them at the root).
/telemetry.jsonl
/baseline-telemetry.jsonl
/policy.onnx
/training-summary.json
# SQLite temp sidecar created when a sqlite :memory: handle gets a file backing.
**:memory:.ses
/.pytest_cache/
.pytest_cache/
# sqlite :memory: temp sidecar, wherever a run drops it
/:memory:.ses

# Engine worker result artifacts (worker runs write these into the engine
# directory when launched bare from there; real receipts live in job dirs /
# the artifact registry). No other engine has these committed, so keep the
# mjlab adapter directory clean the same way.
engines/*/telemetry.jsonl
engines/*/baseline-telemetry.jsonl
engines/*/policy.onnx
engines/*/training-summary.json
engines/*/eval-report.json
