# Standalone Sim2Real web service (local development only; do not copy this
# file wholesale into a public systemd EnvironmentFile).
RDK_SIM2REAL_PORT=18102
RDK_SIM2REAL_BIND_HOST=127.0.0.1
# Optional: set to 1 when the browser MicroDuck bundle is a hard dependency
RDK_SIM2REAL_REQUIRE_MICRODUCK=0
# Leave empty for direct local-port access; production /sim2real/ proxy uses /sim2real
RDK_SIM2REAL_PUBLIC_BASE_PATH=
RDK_SIM2REAL_STORAGE_DIR=.data
RDK_SIM2REAL_DEPLOYMENT=local

# Browser simulator (optional in a clean source checkout). Set one of these
# after downloading a pinned MicroDuck release; do not put a user-uploaded URL
# here. The service serves an explicit 503 guide when neither is configured.
# RDK_SIM2REAL_MICRODUCK_ROOT=/opt/microduck-web/current
# RDK_SIM2REAL_MICRODUCK_URL=https://simulator.example.internal/mujoco/microduck/

# Point this at a trusted internal worker. Use `mock` for a CUDA-free flow test.
RDK_SIM2REAL_LOCAL_RUNNER_URL=http://127.0.0.1:19090/train
RDK_SIM2REAL_LOCAL_RUNNER_MODE=mock
# Maximum queued/running local or RoboGo jobs per account (safe default: 4).
RDK_SIM2REAL_MAX_ACTIVE_RUNS=4
# Crash-window reservations without an external runner id are reaped on the
# next reservation after this TTL (default 24h; accepted range 5m–7d).
RDK_SIM2REAL_ACTIVE_RUN_TTL_SECONDS=86400

# Optional server-side RoboGo adapter. Never put credentials in the browser or git.
RDK_SIM2REAL_ROBOGO_API_URL=
RDK_SIM2REAL_ROBOGO_TOKEN=
RDK_SIM2REAL_ROBOGO_RUNNER_URL=

# Production account boundary. Keep local for a private single-user workstation.
# For a public deployment set web-cloud + SSO_REQUIRED=1 and inject a verified
# adapter (the repository includes a signed trusted-proxy reference).
RDK_SIM2REAL_SSO_REQUIRED=0
RDK_SIM2REAL_AUTH_MODE=
# RDK_SIM2REAL_TRUSTED_PROXY_SECRET=replace-with-at-least-32-random-bytes
# RDK_SIM2REAL_ALLOWED_ORIGINS=https://rdkstudio.d-robotics.cc

# Optional local worker tuning
RDK_SIM2REAL_MOCK_PORT=19090
RDK_SIM2REAL_MOCK_DATA_DIR=.data/mock-worker
