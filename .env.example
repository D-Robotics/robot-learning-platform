# Standalone Sim2Real web service
RDK_SIM2REAL_PORT=18102
RDK_SIM2REAL_BIND_HOST=127.0.0.1
RDK_SIM2REAL_STORAGE_DIR=.data

# Point this at a trusted internal worker. Use `mock` for a CUDA-free flow test.
RDK_SIM2REAL_LOCAL_RUNNER_URL=http://127.0.0.1:19090/train
RDK_SIM2REAL_LOCAL_RUNNER_MODE=mock

# Optional server-side RoboGo adapter. Never put credentials in the browser or git.
RDK_SIM2REAL_ROBOGO_API_URL=
RDK_SIM2REAL_ROBOGO_TOKEN=

# Set to web-cloud only when an explicit shared storage adapter is mounted.
RDK_SIM2REAL_DEPLOYMENT=local
