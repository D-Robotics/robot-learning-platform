# Standalone Sim2Real web service (local development only; do not copy this
# file wholesale into a public systemd EnvironmentFile).
RDK_SIM2REAL_PORT=18102
RDK_SIM2REAL_BIND_HOST=127.0.0.1
# Optional: set to 1 when the browser MicroDuck bundle is a hard dependency
RDK_SIM2REAL_REQUIRE_MICRODUCK=0
# Leave empty for direct local-port access; production /sim2real/ proxy uses /sim2real
RDK_SIM2REAL_PUBLIC_BASE_PATH=
RDK_SIM2REAL_STORAGE_DIR=.data
RDK_SIM2REAL_DEPLOYMENT=local

# Browser simulator (optional in a clean source checkout). Set one of these
# after downloading a pinned MicroDuck release; do not put a user-uploaded URL
# here. The service serves an explicit 503 guide when neither is configured.
# RDK_SIM2REAL_MICRODUCK_ROOT=/opt/microduck-web/current
# RDK_SIM2REAL_MICRODUCK_URL=https://simulator.example.internal/mujoco/microduck/

# Point this at a trusted internal worker. Use `mock` for a CUDA-free flow test.
RDK_SIM2REAL_LOCAL_RUNNER_URL=http://127.0.0.1:19090/train
RDK_SIM2REAL_LOCAL_RUNNER_MODE=mock
# Real local training (engines/starter-ppo, see docs/engines/starter-ppo.md):
# point the worker at the CPU PPO engine instead of the mock.
#   python3 -m pip install --user numpy torch onnx
#   npm run dev:local-worker  (port 19091) with the following two lines set:
# RDK_SIM2REAL_TRAIN_EXECUTABLE=/usr/bin/python3
# RDK_SIM2REAL_TRAIN_ARGS_JSON=["/absolute/path/to/engines/starter-ppo/runner.py"]
# Optional shared secret for a local worker on the same host/network.
# Keep it in a root-only env file; it is never sent to the browser.
# RDK_SIM2REAL_LOCAL_RUNNER_TOKEN=
# Optional loopback BoardAgent reference for read-only deployment preflight.
# It never executes shell commands or enables actuators.
# RDK_SIM2REAL_BOARD_AGENT_URL=http://127.0.0.1:19100
# In production/web-cloud, a configured BoardAgent URL must also have a
# random bearer of at least 32 bytes; local development may leave it blank.
# RDK_SIM2REAL_BOARD_AGENT_TOKEN=
# In a shared RDK Studio deployment, reuse Studio's Local Bridge instead of
# opening a second board tunnel. Forward the browser's Studio cookies and let
# Studio execute the allowlisted BoardAgent calls over its existing bridge.
# RDK_SIM2REAL_STUDIO_EXEC_ORIGIN=http://127.0.0.1:18090
# Optional fallback bridge device id. Prefer setting bridgeDeviceId on each
# visible device record so one deployment can serve multiple Studio devices.
# RDK_SIM2REAL_STUDIO_DEVICE_ID=
# RDK_SIM2REAL_STUDIO_AGENT_PORT=19100
# Maximum queued/running local or RoboGo jobs per account (safe default: 4).
RDK_SIM2REAL_MAX_ACTIVE_RUNS=4
# Crash-window reservations without an external runner id are reaped on the
# next reservation after this TTL (default 24h; accepted range 5m–7d).
RDK_SIM2REAL_ACTIVE_RUN_TTL_SECONDS=86400
# A GPU Worker must pass a fresh health probe before launch (30..86400s).
RDK_SIM2REAL_COMPUTE_HEALTH_TTL_SECONDS=600
# Telemetry retention: positive day count prunes old records (shard + ledger
# index together) on the write path. 0 = keep everything (default). Values that
# are not a positive number <= 3650 are treated as 0.
RDK_SIM2REAL_TELEMETRY_RETENTION_DAYS=0
# Optional HMAC-SHA256 key for short-lived board telemetry attestation tokens.
# Keep at least 32 random bytes in a root-only environment file; never expose
# this key to the browser or commit a real value. Tokens bind owner/run/device.
# RDK_SIM2REAL_TELEMETRY_ATTESTATION_SECRET=replace-with-at-least-32-random-bytes
# Single-writer lease on the storage directory. Leave enabled: it makes a second
# process pointing at the same RDK_SIM2REAL_STORAGE_DIR fail fast (503) instead
# of silently overwriting the ledger. Stale seconds apply to cross-host mounts
# only; same-host decisions use pid liveness.
RDK_SIM2REAL_STORAGE_LEASE=1
RDK_SIM2REAL_STORAGE_LEASE_STALE_SECONDS=300
# Read-only replica: serve queries from a shared storage directory without ever
# writing to it (and without touching the writer lease). Write endpoints fail
# closed. Only one instance may be the writer.
RDK_SIM2REAL_STORAGE_READ_ONLY=0

# ---- Production hardening (see docs/operations.md) ---------------------------
# In-process rate limit per client (IP or account) per minute; 0 disables it.
# Health checks and /metrics are exempt.
RDK_SIM2REAL_RATE_LIMIT_PER_MINUTE=1200
# JSON-lines request logging: debug | info | warn | error | silent.
RDK_SIM2REAL_LOG_LEVEL=info
# Extra CSP sources (comma separated). Only needed when MicroDuck or another
# dependency is served from a different origin than this service.
# RDK_SIM2REAL_CSP_EXTRA_FRAME_SRC=https://simulator.example.internal
# RDK_SIM2REAL_CSP_EXTRA_CONNECT_SRC=
# Emergency valve only: 1 disables the Content-Security-Policy header entirely.
# RDK_SIM2REAL_CSP_DISABLE=0
# Send HSTS. Leave off for plain-HTTP local development.
# RDK_SIM2REAL_ENABLE_HSTS=0
# Only meaningful together with ENABLE_HSTS=1; adds includeSubDomains.
# RDK_SIM2REAL_HSTS_INCLUDE_SUBDOMAINS=0

# Optional server-side RoboGo adapter. Never put credentials in the browser or git.
RDK_SIM2REAL_ROBOGO_API_URL=
RDK_SIM2REAL_ROBOGO_TOKEN=
RDK_SIM2REAL_ROBOGO_RUNNER_URL=

# Production account boundary. Keep local for a private single-user workstation.
# For a public deployment set web-cloud + SSO_REQUIRED=1 and inject a verified
# adapter (the repository includes a signed trusted-proxy reference).
RDK_SIM2REAL_SSO_REQUIRED=0
RDK_SIM2REAL_AUTH_MODE=
# RDK_SIM2REAL_TRUSTED_PROXY_SECRET=replace-with-at-least-32-random-bytes
# RDK_SIM2REAL_ALLOWED_ORIGINS=https://rdkstudio.d-robotics.cc

# Optional local worker tuning
RDK_SIM2REAL_MOCK_PORT=19090
RDK_SIM2REAL_MOCK_DATA_DIR=.data/mock-worker
# Keep the real local worker at 1 on a CPU/single-GPU host so queued jobs do
# not squeeze the control-plane machine. Raise only after capacity testing.
RDK_SIM2REAL_MAX_CONCURRENT_JOBS=1

# Starter engine (engines/starter-ppo) budget overrides; unset means the
# profile defaults from the engine (smoke 40 iters, standard 400).
# RDK_STARTER_ENGINE_ITERATIONS=
# RDK_STARTER_ENGINE_ENVS=
# RDK_STARTER_ENGINE_STEPS=

# Official DSH runtime for the Agent loop (optional during local migration)
# Optional official DSH runtime; enable only after configuring a provider credential.
# RDK_SIM2REAL_DSH_RUNTIME=0
# RDK_SIM2REAL_DSH_HOME=/absolute/path/to/.sim2real-dsh
# Provider credential. RDK_SIM2REAL_DSH_API_KEY is bridged into the DSH
# credential seam at startup and wins over an ambient DEEPSEEK_API_KEY; the
# ambient variable still works when the dedicated one is unset. A missing
# credential fails the chat request with DSH_CREDENTIAL_MISSING instead of
# silently degrading to the canned-reply planner.
# RDK_SIM2REAL_DSH_API_KEY=
# Optional OpenAI-compatible endpoint override (e.g. a Studio LLM gateway).
# RDK_SIM2REAL_DSH_BASE_URL=
# Optional model pin; defaults to deepseek-chat when unset.
# RDK_SIM2REAL_DSH_MODEL=deepseek-chat
