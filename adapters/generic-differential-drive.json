{
  "schemaVersion": 1,
  "id": "generic-differential-drive",
  "displayName": "Generic differential drive",
  "board": { "platform": "linux-generic", "family": "generic-drive", "model": "Generic differential drive" },
  "ros": {
    "topics": {
      "imu": { "name": "/sensors/imu", "type": "sensor_msgs/msg/Imu", "required": true },
      "odom": { "name": "/localization/odom", "type": "nav_msgs/msg/Odometry", "required": false },
      "battery": { "name": "/power/state", "type": "sensor_msgs/msg/BatteryState", "field": "percentage", "required": false },
      "cmdVel": { "name": "/base/cmd_vel", "type": "geometry_msgs/msg/Twist", "required": true }
    }
  },
  "actuator": {
    "kind": "diff-drive", "commandTopic": "/base/cmd_vel", "messageType": "geometry_msgs/msg/Twist",
    "linearAxis": "x", "angularAxis": "z", "maxLinear": 0.3, "maxAngular": 1.0, "watchdogMs": 500
  },
  "runtime": { "decisionHz": 10, "actionProjection": "identity" },
  "safety": { "maxLinear": 0.3, "maxAngular": 1.0, "sensorStallSec": 0.5 },
  "policy": { "observationAdapterId": "imu-gravity-v1", "actionAdapterId": "diff-drive-vw-v1", "observationSize": 42, "actionSize": 2 },
  "capabilities": ["imu", "odom", "battery", "twist"]
}
