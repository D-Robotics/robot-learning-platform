{
  "schemaVersion": 1,
  "id": "generic-differential-drive",
  "displayName": "Generic differential drive",
  "platforms": ["linux-generic"],
  "sensors": {
    "imu": { "topic": "/sensors/imu", "required": true },
    "odom": { "topic": "/localization/odom", "required": false },
    "battery": { "topic": "/power/state", "required": false }
  },
  "actuator": { "type": "twist", "topic": "/base/cmd_vel", "linearAxis": "x", "angularAxis": "z" },
  "runtime": { "decisionHz": 10, "actionProjection": "identity" },
  "safety": { "maxLinear": 0.3, "maxAngular": 1.0, "sensorStallSec": 0.5, "watchdogMs": 500 }
}
