{
  "schemaVersion": 1,
  "id": "isaac-origin-rpo-flat",
  "displayName": "ORIGIN RPO 平地运动策略（Isaac Lab 上游）",
  "kind": "isaac-upstream",
  "adapterId": "isaac-origin-rpo",
  "observationAdapterId": "origin-rpo-78d-v1",
  "actionAdapterId": "origin-rpo-23d-joint-position-v1",
  "recommendedEngine": "isaac-lab",
  "isaacTask": {
    "upstreamTaskId": "RPO-Flat",
    "train": "robolab/scripts/rsl_rl/train.py",
    "play": "robolab/scripts/rsl_rl/play.py",
    "sim2sim": "robolab/scripts/mujoco/sim2sim_rpo.py",
    "jointOrderMapping": [0, 6, 12, 1, 7, 13, 18, 2, 8, 14, 19, 3, 9, 15, 20, 4, 10, 16, 21, 5, 11, 17, 22],
    "controlHz": 50,
    "qualityMetrics": ["velocityTracking", "fallRate", "actionChangeRms"]
  },
  "reward": { "progress": 1.0, "collision": -5, "goal": 10, "actionPenalty": -0.01, "dwell": 0.2 },
  "termination": { "goalDistance": 0.15, "timeoutSteps": 1000 },
  "workspace": { "bound": 5.0, "obstacles": { "count": 0, "radius": 0.15 } },
  "curriculum": {
    "initialGoalDistance": [0.5, 1.0],
    "finalGoalDistance": [1.0, 2.0],
    "expandFactor": 1.08,
    "successRateThreshold": 0.7,
    "lookbackEpisodes": 50
  },
  "domainRandomization": {
    "motorGain": [0.8, 1.2],
    "lagTauSeconds": [0.03, 0.2],
    "gyroNoiseStdRadSec": [0.0, 0.05],
    "odomNoiseStdM": [0.0, 0.02],
    "angularBiasRadSec": [-0.05, 0.05],
    "actionLatencySteps": [0, 3],
    "odomDropoutProb": [0.0, 0.05],
    "slipScale": [0.8, 1.0],
    "evalEnvelopes": {
      "nominal": [1.0, 0.1, 0.01, 0.005, 0.0, 0, 0.0, 1.0],
      "hard": [0.8, 0.2, 0.05, 0.02, 0.05, 3, 0.05, 0.8]
    }
  },
  "evaluationConfig": { "episodesPerEnvelope": 50, "confidenceLevel": 0.95 },
  "qualityGate": {
    "minSuccessRate": 0.7,
    "maxCollisionRate": 0.15,
    "gateOn": "ciLowerBound",
    "maxActionChangeRms": 0.35,
    "ablation": { "requireBaseline": true, "minSuccessRateDelta": 0.1 }
  },
  "evaluation": ["successRate", "fallRate", "velocityTracking", "controlLatency"],
  "provenance": {
    "kind": "task-pack",
    "mock": true,
    "note": "Mirror of the public RPO tutorial task (forum.d-robotics.cc/t/topic/35763, 2026-09-28): PPO in Isaac Lab with domain randomization, in-engine replay (play.py --num_envs=1 --plane), then a MuJoCo sim2sim cross-check (sim2sim_rpo.py --load_model=$POLICY). The upstream workspace owns the real task definition and reward; this pack carries the platform contract (78D frame x 10-frame history = 780D policy input, 23D joint actions), the upstream script paths and the tutorial-documented joint order mapping. Training runs only on a host with RDK_ISAAC_LAB_ROOT set; the adapter refuses elsewhere."
  }
}
