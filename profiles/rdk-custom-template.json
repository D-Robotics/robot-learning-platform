{
  "schemaVersion": 1,
  "id": "rdk-custom-template",
  "displayName": "自研 RDK 机器人（待填写）",
  "board": { "platform": "rdk-x5", "family": "rdk-custom", "model": "请替换为实际型号" },
  "ros": {
    "setupPaths": ["/opt/tros/humble/setup.bash", "/userdata/dev_ws/install/setup.bash"],
    "topics": {
      "imu": { "name": "/imu", "type": "sensor_msgs/msg/Imu", "qos": "best-effort", "required": true },
      "odom": { "name": "/odom", "type": "nav_msgs/msg/Odometry", "qos": "best-effort", "required": false },
      "battery": { "name": "/battery_state", "type": "sensor_msgs/msg/BatteryState", "field": "percentage", "qos": "reliable", "required": false }
    }
  },
  "actuator": {
    "kind": "diff-drive",
    "commandTopic": "/cmd_vel",
    "messageType": "geometry_msgs/msg/Twist",
    "linearAxis": "x",
    "angularAxis": "z",
    "maxLinear": 0.3,
    "maxAngular": 1.0,
    "watchdogMs": 500
  },
  "policy": {
    "observationAdapterId": "imu-gravity-v1",
    "actionAdapterId": "diff-drive-vw-v1",
    "observationSize": 42,
    "actionSize": 2
  },
  "capabilities": ["imu", "odom", "battery", "twist", "cpu-onnx"]
}
