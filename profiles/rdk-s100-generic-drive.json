{
  "schemaVersion": 1,
  "id": "rdk-s100-generic-drive",
  "displayName": "RDK S100 通用差速底盘（契约 profile）",
  "board": {
    "platform": "rdk-s100",
    "family": "rdk-generic-drive",
    "model": "D-Robotics RDK S100（待现场确认）"
  },
  "ros": {
    "setupPaths": [
      "/opt/tros/humble/setup.bash",
      "/userdata/dev_ws/install/setup.bash"
    ],
    "topics": {
      "imu": {
        "name": "/sensors/imu",
        "type": "sensor_msgs/msg/Imu",
        "qos": "best-effort",
        "required": true
      },
      "odom": {
        "name": "/localization/odom",
        "type": "nav_msgs/msg/Odometry",
        "qos": "best-effort",
        "required": false
      },
      "battery": {
        "name": "/power/state",
        "type": "sensor_msgs/msg/BatteryState",
        "field": "percentage",
        "qos": "reliable",
        "required": false
      },
      "cmdVel": {
        "name": "/base/cmd_vel",
        "type": "geometry_msgs/msg/Twist",
        "qos": "reliable",
        "required": true
      }
    }
  },
  "actuator": {
    "kind": "diff-drive",
    "commandTopic": "/base/cmd_vel",
    "messageType": "geometry_msgs/msg/Twist",
    "linearAxis": "x",
    "angularAxis": "z",
    "maxLinear": 0.3,
    "maxAngular": 1.0,
    "watchdogMs": 500
  },
  "runtime": {
    "decisionHz": 10,
    "actionProjection": "identity"
  },
  "safety": {
    "maxLinear": 0.3,
    "maxAngular": 1.0,
    "sensorStallSec": 0.5
  },
  "policy": {
    "observationAdapterId": "imu-gravity-v1",
    "actionAdapterId": "diff-drive-vw-v1",
    "observationSize": 42,
    "actionSize": 2
  },
  "capabilities": [
    "imu",
    "odom",
    "battery",
    "twist",
    "cpu-onnx"
  ],
  "provenance": {
    "kind": "synthetic",
    "mock": true,
    "note": "Contract-only S100 profile; no S100 hardware was connected during validation. Replace topic names after board preflight."
  }
}
