# Direct dependencies of the SmolVLA fine-tuning entry (reference adapter).
#
# Pinned transitively in requirements.txt (`uv pip compile --generate-hashes`),
# so a training run is reproducible in both halves of the provenance contract:
# `sourceCommit` names the code and the lock names the libraries. The engine also
# records the versions it actually imported in each result's `dependencies`
# block, which is what `npm run verify:training-provenance` asserts.
#
# Regenerate after editing this file:
#     npm run lock:engines
#
# Real fine-tuning needs a GPU runner and the model weights — this lock makes
# the dependency set reproducible wherever that runner is. `--dry-run` (plan
# validation) runs on the standard library alone and installs nothing.

# Torch is pinned as the tested CPU/standard wheel (same pin as engines/act). A
# GPU deployment installs its own build from the CUDA index; that wheel is a
# deliberate deployment choice and is recorded per-run in `dependencies.torch`.
numpy==2.0.2
torch==2.8.0

# The HF training stack, pinned to the newest line that still supports the
# repository's Python floor (3.9): transformers 5.x and the matching peft/
# accelerator releases require >=3.10. SmolVLA's ecosystem (lerobot, the
# lerobot/smolvla_base checkpoints) targets transformers 4.x.
transformers==4.57.6
accelerate==1.10.1
peft==0.17.1

# LeRobot datasets are parquet; the loader and the pyarrow-backed dry-run
# inspection both read them through pyarrow.
pyarrow==21.0.0

# Transitive pins. `uv pip compile` resolves these, but nothing constrains them,
# so a fresh resolve picks up newer releases. Pinning here is what makes the
# lock a *reproducible* function of this file instead of a snapshot of one
# resolve. Kept identical to engines/act so the two locks agree on the overlap.
filelock==3.32.7
