        },
        "demonstrationRunId": {
          "type": "string",
          "description": "已上传真实轨迹的来源 Run ID；用于 local + offline-bc，平台校验来源、维度并冻结数据摘要。无有效轨迹会拒绝，不回退合成数据。"
        },
        "backend": {
          "type": "string",
          "enum": ["local", "robogo", "browser", "contract"],
          "description": "执行后端，默认 local；未知值会拒绝。"
        },
        "profile": {
          "type": "string",
