[Unit]
Description=RDK Robot Learning Platform standalone Sim2Real web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sim2real
Group=sim2real
WorkingDirectory=/opt/rdk-robot-learning-platform/current
EnvironmentFile=-/etc/rdk-robot-learning-platform.env
Environment=NODE_ENV=production
Environment=RDK_SIM2REAL_BIND_HOST=127.0.0.1
Environment=RDK_SIM2REAL_PORT=18102
Environment=RDK_SIM2REAL_STORAGE_DIR=/var/lib/rdk-robot-learning-platform
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node --import tsx/esm /opt/rdk-robot-learning-platform/current/services/sim2real-web/server.ts
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/rdk-robot-learning-platform

[Install]
WantedBy=multi-user.target
