# Production runtime overrides for standalone-sim2real.service.
# Copy this file to /etc/rdk-robot-learning-platform-sim2real.env, make it
# root-readable, and fill only the values below. The systemd unit pins and
# validates deployment/auth/storage/bind settings; do not add local .env
# values such as RDK_SIM2REAL_DEPLOYMENT=local or RDK_SIM2REAL_STORAGE_DIR=.data.

# Required for the trusted SSO gateway. Keep this secret out of git and logs.
RDK_SIM2REAL_TRUSTED_PROXY_SECRET=
RDK_SIM2REAL_TRUSTED_PROXY_MAX_AGE_SECONDS=300
RDK_SIM2REAL_ALLOWED_ORIGINS=https://rdkstudio.d-robotics.cc

# Optional browser simulator release.
# RDK_SIM2REAL_MICRODUCK_ROOT=/opt/microduck-web/current
# RDK_SIM2REAL_MICRODUCK_URL=
# RDK_SIM2REAL_REQUIRE_MICRODUCK=0

# Optional local worker or RoboGo connector. Tokens are server-side only.
# RDK_SIM2REAL_LOCAL_RUNNER_URL=http://127.0.0.1:19090/train
# RDK_SIM2REAL_LOCAL_RUNNER_MODE=mock
# Per-account queued/running runner limit; keep the conservative default unless
# the deployment has an external quota service.
RDK_SIM2REAL_MAX_ACTIVE_RUNS=4
# RDK_SIM2REAL_ROBOGO_API_URL=https://robogo.example.internal
# RDK_SIM2REAL_ROBOGO_RUNNER_URL=https://runner.example.internal/train
# Only use this process-wide token in a private single-user deployment. In
# shared/trusted-proxy mode, forward X-RDK-RoboGo-Token per authenticated
# request instead; a global token is deliberately ignored there.
# RDK_SIM2REAL_ROBOGO_TOKEN=
