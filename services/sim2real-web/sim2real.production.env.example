# Production runtime overrides for standalone-sim2real.service.
# Copy this file to /etc/rdk-robot-learning-platform-sim2real.env, make it
# root-readable, and fill only the values below. The systemd unit pins and
# validates deployment/auth/storage/bind settings; do not add local .env
# values such as RDK_SIM2REAL_DEPLOYMENT=local or RDK_SIM2REAL_STORAGE_DIR=.data.

# Required for the trusted SSO gateway. Keep this secret out of git and logs.
RDK_SIM2REAL_TRUSTED_PROXY_SECRET=
RDK_SIM2REAL_TRUSTED_PROXY_MAX_AGE_SECONDS=300
RDK_SIM2REAL_ALLOWED_ORIGINS=https://rdkstudio.d-robotics.cc
EXPRESS_TRUST_PROXY=1
RDK_SIM2REAL_RATE_LIMIT_PER_MINUTE=1200
RDK_SIM2REAL_LOG_LEVEL=info
RDK_SIM2REAL_CSP_DISABLE=0
RDK_SIM2REAL_ENABLE_HSTS=1
RDK_SIM2REAL_HSTS_INCLUDE_SUBDOMAINS=0
RDK_SIM2REAL_STORAGE_LEASE=1
RDK_SIM2REAL_STORAGE_LEASE_STALE_SECONDS=300
RDK_SIM2REAL_STORAGE_READ_ONLY=0
RDK_SIM2REAL_TELEMETRY_RETENTION_DAYS=30
# A successful GPU Worker probe is executable evidence only for this long;
# keep the value bounded so an old online result cannot authorize a launch.
RDK_SIM2REAL_COMPUTE_HEALTH_TTL_SECONDS=600
# HMAC-SHA256 key for short-lived board-agent telemetry attestation tokens.
# Generate at least 32 random bytes and keep this value root-only; the key is
# never sent to Studio or the board. Each token carries owner/runId/deviceId/exp.
RDK_SIM2REAL_TELEMETRY_ATTESTATION_SECRET=replace-with-at-least-32-random-bytes
RDK_SIM2REAL_ACTIVE_RUN_TTL_SECONDS=86400
# Optional dedicated audit volume. If enabled, pass the same path to the
# storage backup/restore CLI so audit.ndjson and its rotated .1 segment travel
# with the ledger snapshot.
# RDK_SIM2REAL_AUDIT_FILE=/var/log/rdk-sim2real/audit.ndjson
# RDK_SIM2REAL_AUDIT_MAX_BYTES=67108864

# Optional browser simulator release.
# RDK_SIM2REAL_MICRODUCK_ROOT=/opt/microduck-web/current
# RDK_SIM2REAL_MICRODUCK_URL=
# RDK_SIM2REAL_REQUIRE_MICRODUCK=0

# Optional local worker or RoboGo connector. Tokens are server-side only.
# Mock-only flow (no CUDA):
# RDK_SIM2REAL_LOCAL_RUNNER_URL=http://127.0.0.1:19090/train
# RDK_SIM2REAL_LOCAL_RUNNER_MODE=mock
# Optional token expected by the local worker (server-side only).
# RDK_SIM2REAL_LOCAL_RUNNER_TOKEN=
# Real local engine: point the runner URL at local-training-worker.mjs and
# configure its executable in a separate root-only worker env file.
# RDK_SIM2REAL_LOCAL_RUNNER_URL=http://127.0.0.1:19091/train
# When LOCAL_RUNNER_URL is enabled in this web-cloud profile, inject a random
# bearer (>=32 bytes) here and configure the worker with the same value.
# RDK_SIM2REAL_LOCAL_RUNNER_TOKEN=
# Optional exact host/IP allowlist for intentionally direct private HTTPS
# compute workers. Keep empty when using the recommended loopback SSH tunnel;
# entries are comma-separated and never wildcarded.
# RDK_SIM2REAL_COMPUTE_ALLOW_PRIVATE_HTTPS_HOSTS=
# Optional direct BoardAgent endpoint. Production requires a random bearer
# (>=32 bytes) whenever this URL is configured; Studio Local Bridge can be used
# instead when the board is reached through the authenticated Studio session.
# RDK_SIM2REAL_BOARD_AGENT_URL=https://board-agent.example.internal
# RDK_SIM2REAL_BOARD_AGENT_TOKEN=
# Per-account queued/running runner limit; keep the conservative default unless
# the deployment has an external quota service.
RDK_SIM2REAL_MAX_ACTIVE_RUNS=4
# RDK_SIM2REAL_ROBOGO_API_URL=https://robogo.example.internal
# RDK_SIM2REAL_ROBOGO_RUNNER_URL=https://runner.example.internal/train
# Only use this process-wide token in a private single-user deployment. In
# shared/trusted-proxy mode, forward X-RDK-RoboGo-Token per authenticated
# request instead; a global token is deliberately ignored there.
# RDK_SIM2REAL_ROBOGO_TOKEN=

# Optional official DSH runtime. It is opt-in because the runtime needs a
# deployment-owned provider credential (DEEPSEEK_API_KEY or an equivalent DSH
# credential store). Leaving it disabled keeps the production template ready
# without advertising an agent surface that cannot answer requests.
# When enabled, DSH composes sessions, conversation, persistence and event
# lifecycle in this service process (Studio remains an optional provider).
# Product rdk_* tools are exposed to the model only when a deployment-owned
# Board/GPU capability handler is explicitly bound; inspect
# GET /api/sim2real/agent/capabilities before treating them as executable.
RDK_SIM2REAL_DSH_RUNTIME=0
# Model used by the DSH conversation agent (independent from the selected
# simulation/training model in the Studio UI).
# RDK_SIM2REAL_DSH_MODEL=deepseek-chat
# To reuse the RDK Studio gateway, point this at its local OpenAI-compatible
# endpoint (for example http://127.0.0.1:8787/v1).
# RDK_SIM2REAL_DSH_BASE_URL=http://127.0.0.1:3100
# RDK_SIM2REAL_DSH_API_KEY=the-RDK-Studio-gateway-client-token
# standalone-sim2real.service grants this narrow directory under
# ProtectSystem=strict; create it as sim2real before enabling DSH.
RDK_SIM2REAL_DSH_HOME=/var/lib/sim2real/dsh
