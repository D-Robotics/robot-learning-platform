[Unit]
Description=RDK X5 Sim2Real board agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/rdk-board-agent/board-agent-x5.py

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rdk-board-agent
EnvironmentFile=/etc/rdk-board-agent/agent.env
ExecStart=/usr/bin/python3 /opt/rdk-board-agent/board-agent-x5.py
Restart=always
RestartSec=2
# The agent handles SIGTERM with a hard exit; keep a short, predictable stop
# window so a stuck ROS destructor can never stretch a restart to the default
# 90 s before systemd resorts to SIGKILL.
TimeoutStopSec=15
NoNewPrivileges=true
# Policy artifacts are pinned under /root/rdk-board-agent/policies by the
# HTTP contract; keep this path readable while all callers remain token gated.
ProtectHome=false
ProtectSystem=strict
UMask=0077
# All command, ready, state and telemetry IPC lives in this root-only
# directory.  Keep /tmp private to the unit and never grant the service a
# shared public IPC path.
ReadWritePaths=/var/lib/rdk-board-agent /var/lib/rdk-board-agent/runtime /var/lib/rdk-board-agent/telemetry /root/rdk-board-agent/policies
PrivateTmp=true

[Install]
WantedBy=multi-user.target
